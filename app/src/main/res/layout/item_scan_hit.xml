<?xml version="1.0" encoding="utf-8"?>
<!-- Signature scan hit row: offset/hex/format + "Extract" and "Carve" (dd) buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="@dimen/space_sm">

    <TextView
        android:id="@+id/scan_hit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:textSize="@dimen/text_sm"
        android:textColor="@color/text_primary"
        android:typeface="monospace"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <Button
            android:id="@+id/btnExtract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_extract"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_extract"
            android:drawableTint="@color/accent"
            android:drawablePadding="@dimen/space_xs"
            android:minHeight="0dp"
            android:padding="@dimen/space_sm" />

        <Button
            android:id="@+id/btnCarve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_carve"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/text_tertiary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_carve"
            android:drawableTint="@color/text_tertiary"
            android:drawablePadding="@dimen/space_xs"
            android:minHeight="0dp"
            android:padding="@dimen/space_sm" />

    </LinearLayout>

</LinearLayout>
