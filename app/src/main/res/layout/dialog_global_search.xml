<?xml version="1.0" encoding="utf-8"?>
<!-- Global search dialog layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <!-- Search scope row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_surface_dim"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/searchScope"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:singleLine="true"
            android:ellipsize="start" />

        <Button
            android:id="@+id/btnChangeDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:background="@null"
            android:minHeight="0dp"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Mode toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnFilename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Query input with clear button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_clear"
            app:tint="@color/text_hint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:backgroundTint="@color/accent"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Search options: stacked vertically so the Chinese labels never crowd
         on narrow phones. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <CheckBox
            android:id="@+id/cbRegex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_regex"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <CheckBox
            android:id="@+id/cbCaseSensitive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_case_sensitive"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- File filter input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etFileFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:singleLine="true"
            android:hint="@string/search_file_filter"
            android:background="@drawable/bg_input"
            android:padding="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />
    </LinearLayout>

    <!-- Flowing indeterminate progress bar while searching. Honor/EMUI's stock
         ProgressBar indeterminate animation renders static/full on some ROMs —
         this custom view draws a sweeping accent bar instead (see
         IndeterminateBar.kt), so the user always sees motion. -->
    <com.usefulunpacker.IndeterminateBar
        android:id="@+id/searchProgress"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- Results -->
    <ListView
        android:id="@+id/listResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:listSelector="#40ffffff"
        android:fastScrollEnabled="true"
        android:fastScrollAlwaysVisible="true"
        android:fastScrollThumbDrawable="@drawable/fastscroll_thumb"
        android:fastScrollTrackDrawable="@drawable/fastscroll_track" />

    <!-- Bottom action bar: stats + continue + close (bottom-right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_surface_dim"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:background="@null"
            android:visibility="gone"
            android:minHeight="0dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@null"
            android:minHeight="0dp"
            android:padding="10dp" />
    </LinearLayout>

</LinearLayout>
