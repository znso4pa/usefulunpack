<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/space_md"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:id="@+id/recycle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_xl"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/recycle_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/text_hint"
            android:singleLine="true"
            android:ellipsize="start"
            android:layout_marginTop="@dimen/space_xs" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xs">

            <TextView
                android:id="@+id/recycle_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_hint" />

            <TextView
                android:id="@+id/recycle_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_hint" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRestore"
        android:layout_width="@dimen/icon_action"
        android:layout_height="@dimen/icon_action"
        android:src="@drawable/ic_recycle"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/accent"
        android:contentDescription="@string/action_restore" />

    <ImageButton
        android:id="@+id/btnPermanentDelete"
        android:layout_width="@dimen/icon_action"
        android:layout_height="@dimen/icon_action"
        android:src="@drawable/ic_clear"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/state_error"
        android:contentDescription="@string/recycle_permanent_delete" />

</LinearLayout>
