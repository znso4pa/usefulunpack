<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — Material (superset of AppCompat) so Material widgets
         like FloatingActionButton get their size/elevation attrs; inherits
         DayNight so system dark mode works -->
    <style name="Theme.UsefulUnpack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/Theme.UsefulUnpack.Dialog</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_surface</item>

        <!-- ⚠️ MaterialComponents 的按钮 / 复选 / 单选 / 开关取的是 colorPrimary，
             不是 colorAccent。这里一直没设 → 全部落回 Material 默认的紫（#6200EE）：
             全局搜索的「更改 / 取消」、回收站的「还原 / 彻底删除」都是那个紫。
             补上整条主色阶，Material 组件才跟主题的青绿一致。 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="colorError">@color/state_error</item>

        <!-- Bigger, styled vertical scrollbars everywhere (also gives the
             Honor/EMUI ROM the drawable it needs to create a non-null
             ScrollBarDrawable — without it, drawing scrollbars NPEs). -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb_vertical</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_track_vertical</item>
        <item name="android:scrollbarSize">14dp</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <item name="android:scrollbarAlwaysDrawVerticalTrack">true</item>
    </style>

    <!-- Dialog theme — dark consistent surface -->
    <style name="Theme.UsefulUnpack.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:background">@color/bg_surface_dim</item>
        <item name="android:windowBackground">@drawable/dialog_bg_rounded</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <!-- 同一条主色阶（对话框里的 Material 按钮按的是这个） -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="colorError">@color/state_error</item>

        <!-- Bigger scrollbars inside dialogs too (preview / editor / lists). -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb_vertical</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_track_vertical</item>
        <item name="android:scrollbarSize">14dp</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <item name="android:scrollbarAlwaysDrawVerticalTrack">true</item>

        <!-- Title -->
        <item name="android:titleTextColor">@color/text_primary</item>

        <!-- List items inside AlertDialog (for setItems / setSingleChoiceItems) -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>

        <!-- Button colors -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.UsefulUnpack.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.UsefulUnpack.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.UsefulUnpack.Button.Neutral</item>
    </style>

    <!-- Dialog buttons -->
    <style name="Widget.UsefulUnpack.Button.Positive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="Widget.UsefulUnpack.Button.Negative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.UsefulUnpack.Button.Neutral" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- 翻新时这里曾放过 TextButton / TextButton.Danger / Button.Filled 三个样式，
         最后各对话框都改用显式 drawable（bg_chip_accent / bg_btn_accent）配普通
         Button —— 样式没人引用就是死代码，已删。要再抽样式先看调用点。 -->

    <!-- Draggable fast-scroll handle styling, applied via AbsListView.setFastScrollStyle -->
    <style name="FastScrollStyle">
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@drawable/fastscroll_track</item>
    </style>
</resources>
