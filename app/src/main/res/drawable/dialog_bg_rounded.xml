<?xml version="1.0" encoding="utf-8"?>
<!-- The only opaque dialog surface; its window and content host stay transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_surface_dim" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="@dimen/corner_dialog" />
</shape>
