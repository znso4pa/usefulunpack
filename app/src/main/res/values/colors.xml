    <!-- ═══ Accent / Brand ═══ -->
    <color name="accent">#35acc6</color>
    <color name="accent_dark">#00728b</color>
    <color name="accent_soft">#2235acc6</color>
    <!-- accent 上压的文字（按钮填充底）——纯黑在青绿上发闷，用带一点青的深色 -->
    <color name="accent_on">#06222a</color>
    <!-- 图标盒 / 徽标的底（比 accent_soft 再实一点，卡片上才看得出） -->
    <color name="accent_soft_strong">#2E35ACC6</color>
    <!-- 选中态描边（分段控件、聚焦输入框） -->
    <color name="accent_line">#5935ACC6</color>
    <!-- 卡片描边：主色的 8%，深色底上刚好是一条发丝线 -->
    <color name="hairline">#14E0F9FF</color>
    <!-- 卡片 / 行的按压涟漪 -->
    <color name="ripple_light">#24FFFFFF</color>

    <!-- ═══ Text — light on dark ═══ -->
    <color name="text_primary">#e0f9ff</color>
    <color name="text_secondary">#b0b0b0</color>
    <color name="text_tertiary">#9a9a9a</color>
    <color name="text_hint">#8f8f8f</color>
    <color name="text_disabled">#666666</color>
    <!-- 代码 token C["tertiary"] / C["tertiary_light"] 的色值。这两个与上面 XML 档
         的 text_tertiary(#9a9a9a) 不是同一个灰 —— 收 token 时按**原值**落盘，不改色。 -->
    <color name="text_tertiary_dim">#888888</color>
    <color name="text_tertiary_light">#aaaaaa</color>

    <!-- Legacy aliases -->
    <color name="ui_base">@color/accent</color>
