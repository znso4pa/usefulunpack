<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-window layout: toolbar + tab bar + ViewPager2 of folder views -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content = ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_file_list">

        <!-- Tab bar on TOP (Chrome-style): horizontal tab strip + add-tab button -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/tabbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_toolbar"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:scrollbars="none" />

            <ImageButton
                android:id="@+id/btnAddTab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add_tab"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/accent"
                android:contentDescription="新建窗口" />
        </LinearLayout>

        <!-- divider under tab bar -->
        <View
            android:id="@+id/dividerTabBar"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/tabBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- divider under toolbar -->
        <View
            android:id="@+id/dividerToolbar"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Custom toolbar area (recycle / home / title / CLI) -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface_raised"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/dividerTabBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnDrawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_drawer"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/ui_icon_tint" />

            <ImageButton
                android:id="@+id/btnRecycle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_recycle"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/ui_icon_tint"
                android:contentDescription="@string/title_recycle_bin" />

            <ImageButton
                android:id="@+id/btnRoot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_home"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/ui_icon_tint"
                android:contentDescription="回到根目录" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UsefulUnpack"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnCLI"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_overflow"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:tint="@color/accent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_more" />
        </LinearLayout>

        <!-- ViewPager2: one FolderFragment per tab -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_file_list"
            app:layout_constraintTop_toBottomOf="@id/dividerToolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Drawer: bookmarks -->
    <LinearLayout
        android:id="@+id/drawerContent"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/bg_drawer">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="@string/drawer_quick_paths"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:background="@color/bg_drawer_header" />

        <ListView
            android:id="@+id/listBookmarks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/bg_drawer_header"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/btnAddBookmark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/drawer_add_current"
            android:textSize="13sp"
            android:textColor="@color/ui_base"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
