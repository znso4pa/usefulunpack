<?xml version="1.0" encoding="utf-8"?>
<!-- Signature scan hit row: offset/hex/format + "Extract" and "Carve" (dd) buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/scan_hit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/text_primary"
        android:typeface="monospace"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btnExtract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_extract"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:background="@null"
            android:minHeight="0dp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnCarve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_carve"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:background="@null"
            android:minHeight="0dp"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>
