<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-window layout: toolbar + tab bar + ViewPager2 of folder views -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content = ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_file_list">

        <!-- Tab bar on TOP (Chrome-style): horizontal tab strip + add-tab button -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/tabbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_toolbar"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:scrollbars="none" />

            <com.usefulunpacker.UuIconButton
                android:id="@+id/btnAddTab"
                android:layout_width="36dp"
                android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_add_tab"
                android:contentDescription="新建窗口" />
        </LinearLayout>

        <!-- divider under tab bar -->
        <View
            android:id="@+id/dividerTabBar"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/tabBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- divider under toolbar -->
        <View
            android:id="@+id/dividerToolbar"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Custom toolbar area (recycle / home / title / CLI) -->
        <com.usefulunpacker.UuActionBar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_surface_raised"
            app:layout_constraintTop_toBottomOf="@id/dividerTabBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.usefulunpacker.UuIconButton
                android:id="@+id/btnDrawer"
                android:layout_width="44dp"
                android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_drawer"
                android:contentDescription="@string/a11y_drawer" />

            <com.usefulunpacker.UuIconButton
                android:id="@+id/btnRecycle"
                android:layout_width="44dp"
                android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_recycle"
                android:contentDescription="@string/title_recycle_bin" />

            <com.usefulunpacker.UuIconButton
                android:id="@+id/btnRoot"
                android:layout_width="44dp"
                android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/a11y_home" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UsefulUnpack"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <com.usefulunpacker.UuIconButton
                android:id="@+id/btnCLI"
                android:layout_width="44dp"
                android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_overflow"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_more" />
        </com.usefulunpacker.UuActionBar>

        <!-- ViewPager2: one FolderFragment per tab -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_file_list"
            app:layout_constraintTop_toBottomOf="@id/dividerToolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 触摸护盾：对话框打开期间盖住**除 tab 栏以外的一切**（工具栏 + 内容区），
             让「弹窗打开后除了 tab 栏什么都点不动」成立 —— 背后的文件列表、工具栏
             按钮全吃不到触摸，杜绝误触；tab 栏留在护盾外面，所以还能切窗口。
             clickable=true 保证事件在这里被吃掉，不会继续往下派发。
             显隐见 MainActivity.setContentBlocked。 -->
        <View
            android:id="@+id/touchShield"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/dividerTabBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Drawer: bookmarks -->
    <com.usefulunpacker.UuSidePanel
        android:id="@+id/drawerContent"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/bg_drawer">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="@string/drawer_quick_paths"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:background="@color/bg_drawer_header" />

        <ListView
            android:id="@+id/listBookmarks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/bg_drawer_header"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <com.usefulunpacker.UuButton
            android:id="@+id/btnAddBookmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:uuActionStyle="text"
            android:text="@string/drawer_add_current" />
    </com.usefulunpacker.UuSidePanel>

</androidx.drawerlayout.widget.DrawerLayout>
